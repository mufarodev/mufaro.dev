# Install as a user unit on each machine:
#   cp scripts/labs-agent.service ~/.config/systemd/user/ && systemctl --user enable --now labs-agent
# Config lives in ~/.config/labs-agent.env (chmod 600); scripts/labs-agent.mjs lists the variables.
[Unit]
Description=Labs resource agent

[Service]
EnvironmentFile=%h/.config/labs-agent.env
ExecStart=/usr/bin/env node %h/mufaro.dev/scripts/labs-agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=default.target
